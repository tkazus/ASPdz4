@model IEnumerable<DzBook.Models.Book>
@{
    ViewData["Title"] = "Каталог книг";
}

<h1>Каталог книг</h1>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Название</th>
            <th>Автор</th>
            <th>Год</th>
            <th>Жанр</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Year</td>
                <td>@book.Genre</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">Подробнее</a>
                </td>
            </tr>
        }
    </tbody>
</table>